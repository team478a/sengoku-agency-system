{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sengoku-ai.local/schemas/orchestrator/task-request.schema.json",
  "title": "Development Orchestrator Task Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "title",
    "repository",
    "base_branch",
    "work_branch",
    "goal",
    "business_context",
    "in_scope",
    "out_of_scope",
    "protected_contracts",
    "implementation_steps",
    "acceptance_criteria",
    "validation",
    "approval_boundaries",
    "dependencies",
    "expected_output_schema"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,80}$"
    },
    "title": {
      "type": "string",
      "minLength": 3,
      "maxLength": 160
    },
    "repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "base_branch": {
      "type": "string",
      "minLength": 1
    },
    "work_branch": {
      "type": "string",
      "minLength": 1
    },
    "goal": {
      "type": "string",
      "minLength": 10
    },
    "business_context": {
      "type": "string",
      "minLength": 1
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "in_scope": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "out_of_scope": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "protected_contracts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "implementation_steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "validation": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "approval_boundaries": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "expected_output_schema": {
      "type": "string",
      "const": "docs/orchestrator/task-result.schema.json"
    }
  }
}
